#!/bin/sh
# Install the CLI tools the shell config expects (starship, eza, bat).
# Works on macOS via Homebrew and on Debian/Ubuntu via apt.
set -e

# This runs from a non-login sh, whose PATH lacks the places tools get
# installed to. Add them so the "already installed?" checks below are honest.
PATH="$HOME/.local/bin:/usr/local/bin:$PATH"

if command -v brew > /dev/null 2>&1; then
  # ~/.Brewfile only exists after rcup has run; fall back to the repo copy.
  brewfile="$HOME/.Brewfile"
  [ -f "$brewfile" ] || brewfile="$HOME/dotfiles/Brewfile"
  brew bundle --file "$brewfile"
  exit 0
fi

if command -v apt-get > /dev/null 2>&1; then
  sudo apt-get update
  # eza is not in Ubuntu 24.04's default repos; the gierens.de repo carries it.
  # git, curl and vim: the git hooks and rcup's post-up hook need them.
  # universal-ctags: git_template/hooks/ctags runs on every commit and checkout.
  sudo apt-get install -y rcm git curl vim universal-ctags \
    bat fzf tmux ripgrep silversearcher-ag gpg
  if ! command -v eza > /dev/null 2>&1; then
    keyring=/etc/apt/keyrings/gierens.gpg
    if [ ! -f "$keyring" ]; then
      # Download first and check it, so a failed fetch cannot leave an empty
      # keyring behind. --batch --yes keeps gpg from prompting on a re-run.
      tmp=$(mktemp)
      wget -qO "$tmp" https://raw.githubusercontent.com/eza-community/eza/main/deb.asc
      sudo mkdir -p /etc/apt/keyrings
      sudo gpg --batch --yes --dearmor -o "$keyring" "$tmp"
      rm -f "$tmp"
    fi
    echo "deb [signed-by=$keyring] http://deb.gierens.de stable main" \
      | sudo tee /etc/apt/sources.list.d/gierens.list > /dev/null
    sudo apt-get update
    sudo apt-get install -y eza
  fi
  if ! command -v starship > /dev/null 2>&1; then
    # Install into ~/.local/bin: no sudo, so it works without a tty.
    # bashrc and path.zsh both put ~/.local/bin on PATH.
    mkdir -p "$HOME/.local/bin"
    curl -sS https://starship.rs/install.sh | sh -s -- --yes --bin-dir "$HOME/.local/bin"
  fi
  exit 0
fi

echo "setup-shell-tools: no supported package manager found" >&2
exit 1
