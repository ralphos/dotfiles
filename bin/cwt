#!/usr/bin/env bash
#
# cwt — create a git worktree and open it as a new tmux window with the
# workspace layout (same as cwork: vim, shell, claude).
#
# Usage:
#   cwt <branch>            # branch off main (creates branch if needed)
#   cwt <branch> <base>     # branch off <base>
#
# Worktrees go in ~/worktrees/<repo>-<branch>.

set -e

if [ -z "$1" ]; then
  echo "Usage: cwt <branch-name> [base-branch=main]" >&2
  exit 1
fi

branch="$1"
base="${2:-main}"

# Tunables (keep in sync with cwork)
SHELL_LINES=10
CLAUDE_WIDTH=35

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  echo "Not inside a git repo." >&2
  exit 1
}
repo_name="$(basename "$repo_root")"
safe_branch="${branch//\//-}"
worktree_dir="$HOME/worktrees/${repo_name}-${safe_branch}"

# Create the worktree if it doesn't already exist.
if [ ! -d "$worktree_dir" ]; then
  mkdir -p "$HOME/worktrees"
  if git -C "$repo_root" show-ref --verify --quiet "refs/heads/$branch"; then
    git -C "$repo_root" worktree add "$worktree_dir" "$branch"
  else
    git -C "$repo_root" worktree add "$worktree_dir" -b "$branch" "$base"
  fi
fi

# Need to be inside tmux to add a window.
if [ -z "$TMUX" ]; then
  echo "Not in a tmux session. Open the worktree in a fresh session with:" >&2
  echo "  cd $worktree_dir && cwork" >&2
  exit 1
fi

# Create the new window in the current session, named after the branch.
left_pane="$(tmux new-window -n "$safe_branch" -c "$worktree_dir" -P -F '#{pane_id}')"

# Build the same layout as cwork using stable pane IDs.
claude_pane="$(tmux split-window -h -l "${CLAUDE_WIDTH}%" -t "$left_pane" -c "$worktree_dir" -P -F '#{pane_id}')"
shell_pane="$(tmux split-window -v -l "$SHELL_LINES" -t "$left_pane" -c "$worktree_dir" -P -F '#{pane_id}')"

# Force exact shell pane height.
tmux resize-pane -t "$shell_pane" -y "$SHELL_LINES"

tmux send-keys -t "$left_pane" "vim" C-m
tmux send-keys -t "$claude_pane" "claude" C-m

tmux select-pane -t "$left_pane"
